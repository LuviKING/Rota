<Window x:Class="Rota.Desktop.OnboardingRoutineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sua rotina · Rota"
        Width="780" Height="720" MinWidth="680" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Rota;component/Assets/Rota.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource BackgroundBrush}"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="RoutineCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="RoutineDatePicker" TargetType="DatePicker">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <ControlTemplate x:Key="RoutineCalendarButtonTemplate" TargetType="Button">
            <Border x:Name="CalendarButtonChrome" Background="Transparent" CornerRadius="7">
                <TextBlock Text="&#xE787;" Style="{StaticResource IconGlyphText}"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="16" Width="22" Height="22" LineHeight="22" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="CalendarButtonChrome" Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="CalendarButtonChrome" Property="Opacity" Value="0.72" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="CalendarButtonChrome" Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="48" Height="48" CornerRadius="14"
                        Background="{DynamicResource PrimarySoftBrush}" Margin="0,0,13,0">
                    <TextBlock Text="&#xE787;" Style="{StaticResource IconGlyphText}"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="21" Width="28" Height="28" LineHeight="28" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Conte um pouco da sua rotina" FontSize="23" FontWeight="Bold" />
                    <TextBlock Text="Essas informações definem os limites usados pelo calendário e pela IA"
                               Foreground="{DynamicResource MutedBrush}" FontSize="10.5"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource PrimarySoftBrush}"
                    CornerRadius="9" Padding="10,6" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="ETAPA 2 DE 3" Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="9" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <StackPanel>
                <Border Style="{StaticResource RoutineCard}">
                    <StackPanel>
                        <TextBlock Text="1. Qual é o seu objetivo?" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="Use um nome curto, como “ENEM 2027”, “Concurso do IFF” ou “Cálculo I”."
                                   Foreground="{DynamicResource MutedBrush}" FontSize="9.5"
                                   TextWrapping="Wrap" Margin="0,4,0,9" />
                        <TextBox x:Name="ObjectiveBox" Style="{StaticResource InputTextBox}"
                                 MaxLength="120" TextChanged="FormInput_Changed"
                                 AutomationProperties.Name="Nome do objetivo" />

                        <TextBlock Text="Prazo do objetivo" FontSize="11" FontWeight="SemiBold"
                                   Margin="0,13,0,5" />
                        <DatePicker x:Name="DeadlinePicker" Style="{StaticResource RoutineDatePicker}"
                                    SelectedDateFormat="Long" SelectedDateChanged="FormInput_Changed"
                                    AutomationProperties.Name="Prazo do objetivo" />
                        <TextBlock Text="Escolha uma data futura. Ela impede que um plano coloque estudos depois do prazo."
                                   Foreground="{DynamicResource MutedBrush}" FontSize="9.5"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource RoutineCard}">
                    <StackPanel>
                        <TextBlock Text="2. Em quais dias você pode estudar?" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="Marque somente os dias que normalmente estão disponíveis. Você poderá ajustar isso depois."
                                   Foreground="{DynamicResource MutedBrush}" FontSize="9.5"
                                   TextWrapping="Wrap" Margin="0,4,0,10" />
                        <UniformGrid Columns="7">
                            <ToggleButton x:Name="MondayChoice" Content="SEG" Tag="Monday"
                                          Style="{StaticResource DayChoiceToggle}" Margin="0,0,6,0"
                                          Checked="FormInput_Changed" Unchecked="FormInput_Changed"
                                          ToolTip="Segunda-feira" AutomationProperties.Name="Estudar na segunda-feira" />
                            <ToggleButton x:Name="TuesdayChoice" Content="TER" Tag="Tuesday"
                                          Style="{StaticResource DayChoiceToggle}" Margin="0,0,6,0"
                                          Checked="FormInput_Changed" Unchecked="FormInput_Changed"
                                          ToolTip="Terça-feira" AutomationProperties.Name="Estudar na terça-feira" />
                            <ToggleButton x:Name="WednesdayChoice" Content="QUA" Tag="Wednesday"
                                          Style="{StaticResource DayChoiceToggle}" Margin="0,0,6,0"
                                          Checked="FormInput_Changed" Unchecked="FormInput_Changed"
                                          ToolTip="Quarta-feira" AutomationProperties.Name="Estudar na quarta-feira" />
                            <ToggleButton x:Name="ThursdayChoice" Content="QUI" Tag="Thursday"
                                          Style="{StaticResource DayChoiceToggle}" Margin="0,0,6,0"
                                          Checked="FormInput_Changed" Unchecked="FormInput_Changed"
                                          ToolTip="Quinta-feira" AutomationProperties.Name="Estudar na quinta-feira" />
                            <ToggleButton x:Name="FridayChoice" Content="SEX" Tag="Friday"
                                          Style="{StaticResource DayChoiceToggle}" Margin="0,0,6,0"
                                          Checked="FormInput_Changed" Unchecked="FormInput_Changed"
                                          ToolTip="Sexta-feira" AutomationProperties.Name="Estudar na sexta-feira" />
                            <ToggleButton x:Name="SaturdayChoice" Content="SÁB" Tag="Saturday"
                                          Style="{StaticResource DayChoiceToggle}" Margin="0,0,6,0"
                                          Checked="FormInput_Changed" Unchecked="FormInput_Changed"
                                          ToolTip="Sábado" AutomationProperties.Name="Estudar no sábado" />
                            <ToggleButton x:Name="SundayChoice" Content="DOM" Tag="Sunday"
                                          Style="{StaticResource DayChoiceToggle}"
                                          Checked="FormInput_Changed" Unchecked="FormInput_Changed"
                                          ToolTip="Domingo" AutomationProperties.Name="Estudar no domingo" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource RoutineCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="3. Quantas horas cabem em cada dia?" FontSize="13" FontWeight="SemiBold" />
                            <Border Grid.Column="1" Background="{DynamicResource PrimarySoftBrush}"
                                    CornerRadius="9" Padding="9,5" Margin="12,0,0,0">
                                <TextBlock x:Name="HoursValueText" Text="5 h por dia"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="10" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <Slider x:Name="HoursSlider" Minimum="1" Maximum="12" Value="5"
                                TickFrequency="0.5" IsSnapToTickEnabled="True"
                                ValueChanged="FormInput_Changed" Margin="0,11,0,5"
                                AutomationProperties.Name="Horas disponíveis por dia selecionado" />
                        <TextBlock x:Name="WeeklyCapacityText" Text="—"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="10"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border x:Name="ValidationPanel" Visibility="Collapsed"
                        Background="{DynamicResource ErrorSoftBrush}" CornerRadius="11"
                        Padding="11,9" Margin="0,0,0,2">
                    <TextBlock x:Name="ValidationText" Foreground="{DynamicResource ErrorBrush}"
                               FontSize="10" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="1,0,16,0">
                <TextBlock x:Name="FormHintText" Text="Preencha os campos para continuar."
                           Foreground="{DynamicResource MutedBrush}" FontSize="9.5"
                           TextWrapping="Wrap" />
                <TextBlock Text="Nada será gerado ou instalado nesta etapa."
                           Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,3,0,0" />
            </StackPanel>
            <Button x:Name="NotNowButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                    Click="NotNow_Click" MinWidth="112" MinHeight="42" IsCancel="True"
                    AutomationProperties.Name="Adiar configuração da rotina">Agora não</Button>
            <Button x:Name="SaveButton" Grid.Column="3" Style="{StaticResource PrimaryButton}"
                    Click="Save_Click" MinWidth="188" MinHeight="42" IsDefault="True" IsEnabled="False"
                    AutomationProperties.Name="Salvar rotina e entrar no Rota">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Salvar e entrar" VerticalAlignment="Center" />
                    <TextBlock Text="&#xE72A;" Style="{StaticResource IconGlyphText}"
                               Foreground="White" FontSize="15" Width="20" Height="20"
                               LineHeight="20" Margin="7,0,0,0" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
