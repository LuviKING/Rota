<Window x:Class="Rota.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações · Rota" Width="760" Height="760" MinWidth="640" MinHeight="500"
        WindowStartupLocation="CenterOwner" Icon="pack://application:,,,/Rota;component/Assets/Rota.ico"
        Background="{DynamicResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="Configurações" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="Ajuste objetivo, capacidade diária e revisões automáticas."
                               Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" HorizontalAlignment="Right" Background="{DynamicResource PrimarySoftBrush}" CornerRadius="10" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock Text="Rota Windows 0.3.2" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="10" FontWeight="SemiBold" />
                </Border>
            </Grid>

            <TextBlock Text="OBJETIVO E ROTINA" Style="{StaticResource SectionLabel}" Margin="2,0,0,7" />
            <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Nome do objetivo" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <TextBox x:Name="ObjectiveBox" Style="{StaticResource InputTextBox}" />
                    <TextBlock Text="Data do objetivo (AAAA-MM-DD)" FontSize="11" FontWeight="SemiBold" Margin="0,12,0,5" />
                    <TextBox x:Name="ObjectiveDateBox" Style="{StaticResource InputTextBox}" />

                    <TextBlock Text="Dias disponíveis" FontSize="11" FontWeight="SemiBold" Margin="0,14,0,6" />
                    <UniformGrid Columns="7">
                        <ToggleButton x:Name="MondayChoice" Content="SEG" Style="{StaticResource DayChoiceToggle}"
                                      Margin="0,0,6,0" ToolTip="Segunda-feira" AutomationProperties.Name="Estudar na segunda-feira" />
                        <ToggleButton x:Name="TuesdayChoice" Content="TER" Style="{StaticResource DayChoiceToggle}"
                                      Margin="0,0,6,0" ToolTip="Terça-feira" AutomationProperties.Name="Estudar na terça-feira" />
                        <ToggleButton x:Name="WednesdayChoice" Content="QUA" Style="{StaticResource DayChoiceToggle}"
                                      Margin="0,0,6,0" ToolTip="Quarta-feira" AutomationProperties.Name="Estudar na quarta-feira" />
                        <ToggleButton x:Name="ThursdayChoice" Content="QUI" Style="{StaticResource DayChoiceToggle}"
                                      Margin="0,0,6,0" ToolTip="Quinta-feira" AutomationProperties.Name="Estudar na quinta-feira" />
                        <ToggleButton x:Name="FridayChoice" Content="SEX" Style="{StaticResource DayChoiceToggle}"
                                      Margin="0,0,6,0" ToolTip="Sexta-feira" AutomationProperties.Name="Estudar na sexta-feira" />
                        <ToggleButton x:Name="SaturdayChoice" Content="SÁB" Style="{StaticResource DayChoiceToggle}"
                                      Margin="0,0,6,0" ToolTip="Sábado" AutomationProperties.Name="Estudar no sábado" />
                        <ToggleButton x:Name="SundayChoice" Content="DOM" Style="{StaticResource DayChoiceToggle}"
                                      ToolTip="Domingo" AutomationProperties.Name="Estudar no domingo" />
                    </UniformGrid>
                    <TextBlock Text="A IA e o calendário usam somente os dias marcados ao distribuir novas sessões."
                               Foreground="{DynamicResource MutedBrush}" FontSize="9.5" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <Grid Margin="0,16,0,3">
                        <TextBlock Text="Limite diário" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="HoursValue" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    </Grid>
                    <Slider x:Name="HoursSlider" Minimum="1" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="HoursSlider_ValueChanged" />
                    <TextBlock Text="A importação é recusada se sessões novas + histórico protegido + revisões runtime excederem este limite." Foreground="{DynamicResource MutedBrush}" FontSize="9.5" TextWrapping="Wrap" />

                    <Grid Margin="0,16,0,3">
                        <TextBlock Text="Bloco preferido" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="BlockValue" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    </Grid>
                    <Slider x:Name="BlockSlider" Minimum="30" Maximum="180" TickFrequency="15" IsSnapToTickEnabled="True" ValueChanged="BlockSlider_ValueChanged" />
                    <TextBlock Text="Esse valor entra no prompt para a IA; sessões individuais ainda podem variar entre 10 e 360 minutos." Foreground="{DynamicResource MutedBrush}" FontSize="9.5" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="LEMBRETE DO WINDOWS" Style="{StaticResource SectionLabel}" Margin="2,0,0,7" />
            <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="124"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,18,0">
                        <CheckBox x:Name="ReminderEnabled" Content="Lembrar de estudar todos os dias" FontWeight="SemiBold" />
                        <TextBlock Text="O Windows abre um resumo curto da agenda no horário escolhido, mesmo quando o Rota estiver fechado."
                                   Foreground="{DynamicResource MutedBrush}" FontSize="9.5" TextWrapping="Wrap" Margin="24,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Horário (HH:mm)" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <TextBox x:Name="ReminderTimeBox" Style="{StaticResource InputTextBox}" MaxLength="5"
                                 IsEnabled="{Binding IsChecked, ElementName=ReminderEnabled}"
                                 ToolTip="Horário diário no formato de 24 horas, por exemplo 19:00"
                                 AutomationProperties.Name="Horário diário do lembrete" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="REVISÕES AUTOMÁTICAS" Style="{StaticResource SectionLabel}" Margin="2,0,0,7" />
            <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox x:Name="ReviewD1" Content="D+1 · no dia seguinte" FontWeight="SemiBold" Margin="0,1,0,10" />
                    <CheckBox x:Name="ReviewD3" Content="D+3 · três dias depois" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <CheckBox x:Name="ReviewD7" Content="D+7 · sete dias depois" FontWeight="SemiBold" />
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,12" />
                    <TextBlock Text="Essas revisões só nascem quando um bloco kind=study é realmente concluído. A data é calculada a partir da conclusão real, não da data planejada." Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="DADOS LOCAIS" Style="{StaticResource SectionLabel}" Margin="2,0,0,7" />
            <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="16" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Arquivo local do Rota" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="DataPathText" Foreground="{DynamicResource MutedBrush}" FontSize="9.5" TextWrapping="Wrap" Margin="0,4,18,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Button Style="{StaticResource SecondaryButton}" Click="OpenDataFolder_Click" Padding="11,6" Margin="0,0,0,7">Abrir pasta</Button>
                        <Button Style="{StaticResource SecondaryButton}" Click="ExportBackup_Click" Padding="11,6">Exportar backup</Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid>
                <Button Style="{StaticResource SecondaryButton}" Click="Cancel_Click" Width="110" HorizontalAlignment="Left" IsCancel="True">Cancelar</Button>
                <Button Style="{StaticResource PrimaryButton}" Click="Save_Click" Width="180" HorizontalAlignment="Right" IsDefault="True">Salvar configurações</Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>

