<Window x:Class="Rota.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rota" Width="1540" Height="940" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Rota;component/Assets/Rota.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <Style x:Key="BareButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="CompactSessionTemplate">
            <Border Background="{Binding CardBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Margin="0,0,8,8"
                    Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="10"
                            Background="{Binding BadgeBackground}"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding IconGlyph}"
                                   Foreground="{Binding AccentBrush}"
                                   FontSize="17" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Subject}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Background="{DynamicResource SubtleBrush}"
                                    CornerRadius="8" Padding="7,2" Margin="9,0,0,0">
                                <TextBlock Text="{Binding MinutesLabel}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="9.5" />
                            </Border>
                            <Border Background="{Binding BadgeBackground}"
                                    CornerRadius="8" Padding="7,2" Margin="6,0,0,0">
                                <TextBlock Text="{Binding KindDisplay}"
                                           Foreground="{Binding AccentBrush}"
                                           FontSize="9" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Topic}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="11.5" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding TargetText}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="10" TextWrapping="Wrap"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Button Tag="{Binding}"
                                Click="CompleteSession_Click"
                                Visibility="{Binding CompleteButtonVisibility}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="10,6"
                                ToolTip="Marcar este bloco como concluído">Concluir</Button>
                        <Border Visibility="{Binding CompletedVisibility}"
                                Background="{DynamicResource SuccessSoftBrush}"
                                CornerRadius="9" Padding="9,5">
                            <TextBlock Text="✓ Concluído"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       FontSize="9.5" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="18,20,18,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="14"
                            Background="{DynamicResource PrimaryBrush}">
                        <TextBlock Text="R" Foreground="White"
                                   FontSize="23" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,2,0,0">
                        <TextBlock Text="Rota"
                                   Foreground="{DynamicResource SidebarTextBrush}"
                                   FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="Calendário de estudos"
                                   Foreground="{DynamicResource SidebarMutedBrush}"
                                   FontSize="10.5" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Style="{StaticResource BareButton}"
                            Click="TodayNav_Click" Margin="0,0,0,5"
                            ToolTip="Ir para hoje (Ctrl+T)">
                        <Border CornerRadius="11" Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⌂" Foreground="{DynamicResource SidebarMutedBrush}"
                                           FontSize="16" Width="28" />
                                <TextBlock Text="Hoje" Foreground="{DynamicResource SidebarTextBrush}"
                                           FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Button>
                    <Button Style="{StaticResource BareButton}"
                            Click="CalendarNav_Click" Margin="0,0,0,5">
                        <Border CornerRadius="11" Padding="12,10"
                                Background="{DynamicResource NavSelectedBrush}"
                                BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▦" Foreground="{DynamicResource PrimaryBrush}"
                                           FontSize="16" Width="28" />
                                <TextBlock Text="Calendário" Foreground="{DynamicResource SidebarTextBrush}"
                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Button>
                    <Button Style="{StaticResource BareButton}"
                            Click="AiNav_Click" Margin="0,0,0,5"
                            ToolTip="Criar ou atualizar plano com IA (Ctrl+G)">
                        <Border CornerRadius="11" Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✦" Foreground="{DynamicResource SidebarMutedBrush}"
                                           FontSize="16" Width="28" />
                                <TextBlock Text="Plano / IA" Foreground="{DynamicResource SidebarTextBrush}"
                                           FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Button>
                    <Button Style="{StaticResource BareButton}"
                            Click="ImportNav_Click" Margin="0,0,0,5"
                            ToolTip="Importar StudyPlan JSON (Ctrl+I)">
                        <Border CornerRadius="11" Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⇧" Foreground="{DynamicResource SidebarMutedBrush}"
                                           FontSize="16" Width="28" />
                                <TextBlock Text="Importar JSON" Foreground="{DynamicResource SidebarTextBrush}"
                                           FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Button>
                    <Button Style="{StaticResource BareButton}"
                            Click="SettingsNav_Click"
                            ToolTip="Abrir configurações (Ctrl+,)">
                        <Border CornerRadius="11" Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" Foreground="{DynamicResource SidebarMutedBrush}"
                                           FontSize="15" Width="28" />
                                <TextBlock Text="Configurações" Foreground="{DynamicResource SidebarTextBrush}"
                                           FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Button>
                </StackPanel>

                <Border Grid.Row="4"
                        Background="{DynamicResource SidebarCardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="15" Padding="14">
                    <StackPanel>
                        <TextBlock Text="OBJETIVO"
                                   Foreground="{DynamicResource SidebarMutedBrush}"
                                   FontSize="9.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ObjectiveTitle}"
                                   Foreground="{DynamicResource SidebarTextBrush}"
                                   FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding ObjectiveDateDisplay}"
                                   Foreground="{DynamicResource SidebarMutedBrush}"
                                   FontSize="10" Margin="0,4,0,0" />
                        <Border Height="1" Background="{DynamicResource BorderBrush}"
                                Margin="0,11,0,9" />
                        <TextBlock Text="{Binding PlanLabel}"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   FontSize="9.5" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="6"
                        Background="{DynamicResource SidebarCardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="15" Padding="12">
                    <StackPanel>
                        <TextBlock Text="TEMA"
                                   Foreground="{DynamicResource SidebarMutedBrush}"
                                   FontSize="9.5" FontWeight="SemiBold"
                                   Margin="2,0,0,5" />
                        <Button Style="{StaticResource BareButton}"
                                Tag="dark" Click="ThemeChoice_Click">
                            <Border CornerRadius="10" Padding="9,8">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="☾" Foreground="{DynamicResource SidebarMutedBrush}"
                                                   FontSize="16" Width="28" />
                                        <TextBlock Text="Escuro"
                                                   Foreground="{DynamicResource SidebarTextBrush}"
                                                   FontSize="11.5" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="●"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               Visibility="{Binding DarkThemeSelectedVisibility}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Button>
                        <Button Style="{StaticResource BareButton}"
                                Tag="light" Click="ThemeChoice_Click">
                            <Border CornerRadius="10" Padding="9,8">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="☀" Foreground="{DynamicResource SidebarMutedBrush}"
                                                   FontSize="15" Width="28" />
                                        <TextBlock Text="Claro"
                                                   Foreground="{DynamicResource SidebarTextBrush}"
                                                   FontSize="11.5" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="●"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               Visibility="{Binding LightThemeSelectedVisibility}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main calendar-first content -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="26,20,26,28">
            <StackPanel x:Name="CalendarHost">
                <!-- Context cards -->
                <ItemsControl ItemsSource="{Binding OverviewCards}" Margin="0,0,0,14">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="11"
                                    Padding="14,10" Margin="0,0,8,0"
                                    MinHeight="66">
                                <StackPanel>
                                    <TextBlock Text="{Binding Caption}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="9.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Value}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="13.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0"
                                               ToolTip="{Binding Value}" />
                                    <TextBlock Text="{Binding Detail}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="9.5"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0"
                                               ToolTip="{Binding Detail}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Month navigation -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ItemsControl ItemsSource="{Binding MonthTabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource BareButton}"
                                        Tag="{Binding IsoMonth}"
                                        Click="MonthTab_Click"
                                        Margin="0,0,8,0">
                                    <Border Background="{Binding Background}"
                                            BorderBrush="{Binding Border}"
                                            BorderThickness="1"
                                            CornerRadius="11"
                                            Padding="20,9">
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{Binding Foreground}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}"
                                Click="TodayNav_Click" Padding="13,8"
                                Margin="0,0,7,0">Hoje</Button>
                        <Button Style="{StaticResource SecondaryButton}"
                                Click="PreviousMonth_Click" Padding="11,8"
                                Margin="0,0,5,0" ToolTip="Mês anterior">‹</Button>
                        <Button Style="{StaticResource SecondaryButton}"
                                Click="NextMonth_Click" Padding="11,8"
                                Margin="0,0,7,0" ToolTip="Próximo mês">›</Button>
                        <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="11"
                                Padding="13,8" Margin="0,0,7,0">
                            <TextBlock Text="{Binding MonthTitle}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="11.5" FontWeight="SemiBold" />
                        </Border>
                        <Button Style="{StaticResource SecondaryButton}"
                                Click="ThemeToggle_Click"
                                Padding="11,8"
                                ToolTip="Alternar tema claro/escuro">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ThemeGlyph}" FontSize="14" />
                                <TextBlock Text="{Binding ThemeLabel}" Margin="6,0,0,0"
                                           FontSize="10.5" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{DynamicResource BorderBrush}"
                        Margin="0,0,0,9" />

                <!-- Week headers -->
                <UniformGrid Columns="7" Margin="0,0,0,4">
                    <TextBlock Text="Seg" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
                    <TextBlock Text="Ter" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
                    <TextBlock Text="Qua" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
                    <TextBlock Text="Qui" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
                    <TextBlock Text="Sex" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
                    <TextBlock Text="Sáb" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
                    <TextBlock Text="Dom" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
                </UniformGrid>

                <!-- Full month grid -->
                <ItemsControl ItemsSource="{Binding MonthDays}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource BareButton}"
                                    Tag="{Binding IsoDate}"
                                    Click="MonthDay_Click"
                                    Margin="0,0,6,6"
                                    Height="78">
                                <Border Background="{Binding Background}"
                                        BorderBrush="{Binding Border}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="10,8"
                                        Opacity="{Binding Opacity}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock Text="{Binding Day}"
                                                       Foreground="{Binding Foreground}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding StatusSymbol}"
                                                       Foreground="{Binding AccentBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Summary}"
                                                   Foreground="{Binding MutedForeground}"
                                                   FontSize="9.5"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Bottom"
                                                   MaxHeight="32" />
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="3,1,0,11">
                    <TextBlock Text="✓ concluído" Foreground="{DynamicResource MutedBrush}" FontSize="9.5" Margin="0,0,18,0" />
                    <TextBlock Text="• conteúdo" Foreground="{DynamicResource MutedBrush}" FontSize="9.5" Margin="0,0,18,0" />
                    <TextBlock Text="↻ revisão" Foreground="{DynamicResource MutedBrush}" FontSize="9.5" Margin="0,0,18,0" />
                    <TextBlock Text="★ simulado/prova" Foreground="{DynamicResource MutedBrush}" FontSize="9.5" />
                </StackPanel>

                <!-- Selected day agenda -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="15"
                        Padding="16,14,12,10">
                    <StackPanel>
                        <Grid Margin="2,0,4,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedDateHeading}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="17" FontWeight="SemiBold" />
                                <Border Background="{DynamicResource SubtleBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9" Padding="8,3"
                                        Margin="10,0,0,0">
                                    <TextBlock Text="{Binding PlanContextLabel}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="9.5" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedDateMeta}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <Border Background="{DynamicResource PrimarySoftBrush}"
                                        CornerRadius="9" Padding="9,5">
                                    <TextBlock Text="{Binding ProgressText}"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border Visibility="{Binding EmptyVisibility}"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="24" Margin="0,0,4,4">
                            <StackPanel HorizontalAlignment="Center" Margin="0,14">
                                <Border Width="42" Height="42" CornerRadius="13"
                                        Background="{DynamicResource PrimarySoftBrush}">
                                    <TextBlock Text="✓"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               FontSize="20" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Nenhum bloco neste dia"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Margin="0,10,0,0" />
                                <TextBlock Text="Selecione outro dia ou importe um StudyPlan para preencher o calendário."
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="10" Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding DaySessions}"
                                      ItemTemplate="{StaticResource CompactSessionTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
