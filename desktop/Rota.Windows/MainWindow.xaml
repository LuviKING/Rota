<Window x:Class="Rota.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rota" Width="1540" Height="940" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Rota;component/Assets/Rota.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <Style x:Key="BareButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                <Setter TargetName="Root" Property="Opacity" Value="0.94" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                                <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="Root" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarNavigationButton" TargetType="Button" BasedOn="{StaticResource BareButton}">
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="ThemeOptionButton" TargetType="Button" BasedOn="{StaticResource BareButton}">
            <Setter Property="MinHeight" Value="44" />
        </Style>

        <Style x:Key="SidebarIconContainer" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="CompactSessionTemplate">
            <Border Background="{Binding CardBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Margin="0,0,8,8"
                    Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="12"
                            Background="{Binding BadgeBackground}"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding IconGlyph}"
                                   Foreground="{Binding AccentBrush}"
                                   Style="{StaticResource SymbolGlyphText}"
                                   FontSize="20" Width="28" Height="28" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Subject}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Background="{DynamicResource SubtleBrush}"
                                    CornerRadius="8" Padding="7,2" Margin="9,0,0,0">
                                <TextBlock Text="{Binding MinutesLabel}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="9.5" />
                            </Border>
                            <Border Background="{Binding BadgeBackground}"
                                    CornerRadius="8" Padding="7,2" Margin="6,0,0,0">
                                <TextBlock Text="{Binding KindDisplay}"
                                           Foreground="{Binding AccentBrush}"
                                           FontSize="9" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Topic}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="11.5" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding TargetText}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="10" TextWrapping="Wrap"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Button Tag="{Binding}"
                                Click="CompleteSession_Click"
                                Visibility="{Binding CompleteButtonVisibility}"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="104" Padding="11,7"
                                ToolTip="Marcar este bloco como concluído">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource IconGlyphText}"
                                           FontSize="14" Width="18" Height="18" LineHeight="18" />
                                <TextBlock Text="Concluir" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border Visibility="{Binding CompletedVisibility}"
                                Background="{DynamicResource SuccessSoftBrush}"
                                CornerRadius="9" Padding="9,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✓" Style="{StaticResource SymbolGlyphText}"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           FontSize="13" Width="17" Height="17" LineHeight="17" />
                                <TextBlock Text="Concluído"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           FontSize="10" FontWeight="SemiBold"
                                           Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="18,20,18,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="14"
                            Background="{DynamicResource PrimaryBrush}">
                        <TextBlock Text="R" Foreground="White"
                                   FontSize="23" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,2,0,0">
                        <TextBlock Text="Rota"
                                   Foreground="{DynamicResource SidebarTextBrush}"
                                   FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="Calendário de estudos"
                                   Foreground="{DynamicResource SidebarMutedBrush}"
                                   FontSize="10.5" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button x:Name="TodayNavigationButton"
                            Style="{StaticResource SidebarNavigationButton}"
                            Click="TodayNav_Click"
                            ToolTip="Ir para hoje (Ctrl+T)">
                        <Border CornerRadius="11" Padding="8,6">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource SidebarIconContainer}">
                                    <TextBlock Text="&#xE80F;" Style="{StaticResource IconGlyphText}"
                                               Foreground="{DynamicResource SidebarMutedBrush}"
                                               FontSize="19" />
                                </Border>
                                <TextBlock Text="Hoje" Foreground="{DynamicResource SidebarTextBrush}"
                                           FontSize="12.5" Margin="11,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Button>
                    <Button Style="{StaticResource SidebarNavigationButton}"
                            Click="CalendarNav_Click">
                        <Border CornerRadius="11" Padding="8,6"
                                Background="{DynamicResource NavSelectedBrush}"
                                BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource SidebarIconContainer}"
                                        Background="{DynamicResource PrimarySoftBrush}">
                                    <TextBlock Text="&#xE787;" Style="{StaticResource IconGlyphText}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="19" />
                                </Border>
                                <TextBlock Text="Calendário" Foreground="{DynamicResource SidebarTextBrush}"
                                           FontSize="12.5" FontWeight="SemiBold"
                                           Margin="11,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Button>
                    <Button x:Name="AiNavigationButton"
                            Style="{StaticResource SidebarNavigationButton}"
                            Click="AiNav_Click"
                            ToolTip="Abrir Assistente IA local (Ctrl+G)">
                        <Border CornerRadius="11" Padding="8,6">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource SidebarIconContainer}">
                                    <TextBlock Text="&#xEA80;" Style="{StaticResource IconGlyphText}"
                                               Foreground="{DynamicResource SidebarMutedBrush}"
                                               FontSize="19" />
                                </Border>
                                <TextBlock Text="Assistente IA" Foreground="{DynamicResource SidebarTextBrush}"
                                           FontSize="12.5" Margin="11,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Button>
                    <Button Style="{StaticResource SidebarNavigationButton}"
                            Click="ImportNav_Click"
                            ToolTip="Importar StudyPlan JSON (Ctrl+I)">
                        <Border CornerRadius="11" Padding="8,6">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource SidebarIconContainer}">
                                    <TextBlock Text="&#xE898;" Style="{StaticResource IconGlyphText}"
                                               Foreground="{DynamicResource SidebarMutedBrush}"
                                               FontSize="19" />
                                </Border>
                                <TextBlock Text="Importar JSON" Foreground="{DynamicResource SidebarTextBrush}"
                                           FontSize="12.5" Margin="11,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Button>
                    <Button Style="{StaticResource SidebarNavigationButton}"
                            Click="SettingsNav_Click"
                            ToolTip="Abrir configurações (Ctrl+,)">
                        <Border CornerRadius="11" Padding="8,6">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource SidebarIconContainer}">
                                    <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyphText}"
                                               Foreground="{DynamicResource SidebarMutedBrush}"
                                               FontSize="19" />
                                </Border>
                                <TextBlock Text="Configurações" Foreground="{DynamicResource SidebarTextBrush}"
                                           FontSize="12.5" Margin="11,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Button>
                </StackPanel>

                <Border Grid.Row="4"
                        Background="{DynamicResource SidebarCardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="15" Padding="14">
                    <StackPanel>
                        <TextBlock Text="OBJETIVO"
                                   Foreground="{DynamicResource SidebarMutedBrush}"
                                   FontSize="9.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ObjectiveTitle}"
                                   Foreground="{DynamicResource SidebarTextBrush}"
                                   FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding ObjectiveDateDisplay}"
                                   Foreground="{DynamicResource SidebarMutedBrush}"
                                   FontSize="10" Margin="0,4,0,0" />
                        <Border Height="1" Background="{DynamicResource BorderBrush}"
                                Margin="0,11,0,9" />
                        <TextBlock Text="{Binding PlanLabel}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="9.5" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="6"
                        Background="{DynamicResource SidebarCardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="15" Padding="12">
                    <StackPanel>
                        <TextBlock Text="TEMA"
                                   Foreground="{DynamicResource SidebarMutedBrush}"
                                   FontSize="9.5" FontWeight="SemiBold"
                                   Margin="2,0,0,5" />
                        <Button Style="{StaticResource ThemeOptionButton}"
                                Tag="dark" Click="ThemeChoice_Click">
                            <Border CornerRadius="10" Padding="7,5">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource SidebarIconContainer}" Width="32" Height="32">
                                            <TextBlock Text="☾" Style="{StaticResource SymbolGlyphText}"
                                                       Foreground="{DynamicResource SidebarMutedBrush}"
                                                       FontSize="18" Width="24" Height="24" />
                                        </Border>
                                        <TextBlock Text="Escuro"
                                                   Foreground="{DynamicResource SidebarTextBrush}"
                                                   FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Width="9" Height="9" CornerRadius="5"
                                            Background="{DynamicResource PrimaryBrush}"
                                            Visibility="{Binding DarkThemeSelectedVisibility}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Button>
                        <Button Style="{StaticResource ThemeOptionButton}"
                                Tag="light" Click="ThemeChoice_Click">
                            <Border CornerRadius="10" Padding="7,5">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource SidebarIconContainer}" Width="32" Height="32">
                                            <TextBlock Text="☀" Style="{StaticResource SymbolGlyphText}"
                                                       Foreground="{DynamicResource SidebarMutedBrush}"
                                                       FontSize="18" Width="24" Height="24" />
                                        </Border>
                                        <TextBlock Text="Claro"
                                                   Foreground="{DynamicResource SidebarTextBrush}"
                                                   FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Width="9" Height="9" CornerRadius="5"
                                            Background="{DynamicResource PrimaryBrush}"
                                            Visibility="{Binding LightThemeSelectedVisibility}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main calendar-first content -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="26,20,26,28">
            <StackPanel x:Name="CalendarHost">
                <!-- Context cards -->
                <ItemsControl ItemsSource="{Binding OverviewCards}" Margin="0,0,0,14">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="11"
                                    Padding="14,10" Margin="0,0,8,0"
                                    MinHeight="66">
                                <StackPanel>
                                    <TextBlock Text="{Binding Caption}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="9.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Value}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="13.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0"
                                               ToolTip="{Binding Value}" />
                                    <TextBlock Text="{Binding Detail}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="9.5"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0"
                                               ToolTip="{Binding Detail}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="OverdueStatusPanel"
                        Visibility="{Binding OverdueStatusVisibility}"
                        Background="{DynamicResource AssessmentSoftBrush}"
                        BorderBrush="{DynamicResource AssessmentBrush}"
                        BorderThickness="1" CornerRadius="12"
                        Padding="14,11" Margin="0,0,8,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="11"
                                Background="{DynamicResource SurfaceRaisedBrush}" Margin="0,0,11,0">
                            <TextBlock Text="&#xE823;" Style="{StaticResource IconGlyphText}"
                                       Foreground="{DynamicResource AssessmentBrush}"
                                       FontSize="18" Width="24" Height="24" LineHeight="24" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding OverdueStatusTitle}"
                                       FontSize="12.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding OverdueStatusDetail}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="9.5" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button x:Name="OverdueRecoveryButton" Grid.Column="2"
                                Style="{StaticResource SecondaryButton}"
                                Click="OverdueRecovery_Click" MinWidth="138" MinHeight="42"
                                Margin="14,0,0,0">Revisar atrasos</Button>
                    </Grid>
                </Border>

                <!-- Month navigation -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  Margin="0,0,12,0">
                    <ItemsControl ItemsSource="{Binding MonthTabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource BareButton}"
                                        Tag="{Binding IsoMonth}"
                                        Click="MonthTab_Click"
                                        Margin="0,0,8,0">
                                    <Border Background="{Binding Background}"
                                            BorderBrush="{Binding Border}"
                                            BorderThickness="1"
                                            CornerRadius="11"
                                            Padding="16,9">
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{Binding Foreground}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}"
                                Click="TodayNav_Click" Padding="13,8"
                                Margin="0,0,7,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE787;" Style="{StaticResource IconGlyphText}"
                                           FontSize="14" Width="18" Height="18" LineHeight="18" />
                                <TextBlock Text="Hoje" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PreviousMonthButton"
                                Style="{StaticResource IconButton}"
                                Click="PreviousMonth_Click"
                                Margin="0,0,5,0" ToolTip="Mês anterior"
                                AutomationProperties.Name="Mês anterior">&#xE76B;</Button>
                        <Button x:Name="NextMonthButton"
                                Style="{StaticResource IconButton}"
                                Click="NextMonth_Click"
                                Margin="0,0,7,0" ToolTip="Próximo mês"
                                AutomationProperties.Name="Próximo mês">&#xE76C;</Button>
                        <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="11"
                                Padding="13,8" Margin="0,0,7,0">
                            <TextBlock Text="{Binding MonthTitle}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="11.5" FontWeight="SemiBold" />
                        </Border>
                        <Button Style="{StaticResource SecondaryButton}"
                                Click="ThemeToggle_Click"
                                Padding="11,8"
                                ToolTip="Alternar tema claro/escuro">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="26" Height="26" CornerRadius="8"
                                        Background="{DynamicResource SubtleBrush}">
                                    <TextBlock Text="{Binding ThemeGlyph}"
                                               Style="{StaticResource SymbolGlyphText}"
                                               FontSize="17" Width="22" Height="22" />
                                </Border>
                                <TextBlock Text="{Binding ThemeLabel}" Margin="6,0,0,0"
                                           FontSize="10.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{DynamicResource BorderBrush}"
                        Margin="0,0,0,9" />

                <!-- Week headers -->
                <UniformGrid Columns="7" Margin="0,0,0,4">
                    <TextBlock Text="Seg" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
                    <TextBlock Text="Ter" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
                    <TextBlock Text="Qua" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
                    <TextBlock Text="Qui" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
                    <TextBlock Text="Sex" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
                    <TextBlock Text="Sáb" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
                    <TextBlock Text="Dom" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
                </UniformGrid>

                <!-- Full month grid -->
                <ItemsControl ItemsSource="{Binding MonthDays}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource BareButton}"
                                    Tag="{Binding IsoDate}"
                                    Click="MonthDay_Click"
                                    Margin="0,0,6,6"
                                    Height="80">
                                <Border Background="{Binding Background}"
                                        BorderBrush="{Binding Border}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="10,8"
                                        Opacity="{Binding Opacity}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock Text="{Binding Day}"
                                                       Foreground="{Binding Foreground}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding StatusSymbol}"
                                                       Foreground="{Binding AccentBrush}"
                                                       Style="{StaticResource SymbolGlyphText}"
                                                       FontSize="14" Width="20" Height="20" LineHeight="20"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Summary}"
                                                   Foreground="{Binding MutedForeground}"
                                                   FontSize="9.5"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Bottom"
                                                   MaxHeight="32" />
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="3,2,0,12">
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBlock Text="✓" Style="{StaticResource SymbolGlyphText}"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   FontSize="13" Width="18" Height="18" LineHeight="18" />
                        <TextBlock Text="concluído" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBlock Text="•" Style="{StaticResource SymbolGlyphText}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="16" Width="18" Height="18" LineHeight="18" />
                        <TextBlock Text="conteúdo" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBlock Text="↻" Style="{StaticResource SymbolGlyphText}"
                                   Foreground="{DynamicResource ReviewBrush}"
                                   FontSize="14" Width="18" Height="18" LineHeight="18" />
                        <TextBlock Text="revisão" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="★" Style="{StaticResource SymbolGlyphText}"
                                   Foreground="{DynamicResource AssessmentBrush}"
                                   FontSize="13" Width="18" Height="18" LineHeight="18" />
                        <TextBlock Text="simulado/prova" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Selected day agenda -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="15"
                        Padding="16,14,12,10">
                    <StackPanel>
                        <Grid Margin="2,0,4,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedDateHeading}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="17" FontWeight="SemiBold" />
                                <Border Background="{DynamicResource SubtleBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9" Padding="8,3"
                                        Margin="10,0,0,0">
                                    <TextBlock Text="{Binding PlanContextLabel}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="9.5" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedDateMeta}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <Border Background="{DynamicResource PrimarySoftBrush}"
                                        CornerRadius="9" Padding="9,5">
                                    <TextBlock Text="{Binding ProgressText}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border Visibility="{Binding EmptyVisibility}"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="24" Margin="0,0,4,4">
                            <StackPanel HorizontalAlignment="Center" Margin="0,14">
                                <Border Width="48" Height="48" CornerRadius="14"
                                        Background="{DynamicResource PrimarySoftBrush}">
                                    <TextBlock Text="✓"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Style="{StaticResource SymbolGlyphText}"
                                               FontSize="22" Width="30" Height="30" />
                                </Border>
                                <TextBlock Text="Nenhum bloco neste dia"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Margin="0,10,0,0" />
                                <TextBlock Text="Selecione outro dia ou importe um StudyPlan para preencher o calendário."
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="10" Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding DaySessions}"
                                      ItemTemplate="{StaticResource CompactSessionTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
