<Window x:Class="Rota.Desktop.ProgressHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Histórico de progresso · Rota" Width="940" Height="740" MinWidth="760" MinHeight="580"
        WindowStartupLocation="CenterOwner" Icon="pack://application:,,,/Rota;component/Assets/Rota.ico"
        Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <Style x:Key="HistoryProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{DynamicResource SubtleBrush}" CornerRadius="4" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{DynamicResource PrimaryBrush}" CornerRadius="4" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="52" Height="52" CornerRadius="15" Background="{DynamicResource PrimarySoftBrush}">
                <TextBlock Text="&#xE81C;" Style="{StaticResource IconGlyphText}" FontSize="24"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,1,0,0">
                <TextBlock Text="Histórico de progresso" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Meses recentes e comparação com a semana anterior"
                           Foreground="{DynamicResource MutedBrush}" FontSize="10.5" Margin="0,5,0,0" />
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,20,0,14">
            <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="MINUTOS CONCLUÍDOS" Style="{StaticResource SectionLabel}"/><TextBlock Text="{Binding TotalCompletedMinutesLabel}" FontSize="18" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="em todo o histórico salvo" Foreground="{DynamicResource MutedBrush}" FontSize="9.5" Margin="0,3,0,0"/></StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="SESSÕES CONCLUÍDAS" Style="{StaticResource SectionLabel}"/><TextBlock Text="{Binding TotalCompletedSessionsLabel}" FontSize="18" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="em todo o histórico salvo" Foreground="{DynamicResource MutedBrush}" FontSize="9.5" Margin="0,3,0,0"/></StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14,12">
                <StackPanel><TextBlock Text="MESES COM PLANO" Style="{StaticResource SectionLabel}"/><TextBlock Text="{Binding ActiveMonthsLabel}" FontSize="18" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="nos últimos 12 meses" Foreground="{DynamicResource MutedBrush}" FontSize="9.5" Margin="0,3,0,0"/></StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.92*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.08*"/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="ÚLTIMOS 12 MESES" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="MonthlyHistoryItems" ItemsSource="{Binding Months}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding MonthLabel}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1" Style="{StaticResource HistoryProgressBar}" Maximum="100" Value="{Binding CompletionPercent}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding CompletionLabel}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding MinutesLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="9" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="COMPARAÇÃO SEMANAL" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="WeeklyComparisonItems" ItemsSource="{Binding Weeks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding RangeLabel}" FontSize="11" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding SessionsLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="9.5" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding MinutesLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                            <Border Grid.Column="2" Background="{Binding ChangeBackground}" CornerRadius="8" Padding="7,4" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ChangeLabel}" Foreground="{Binding ChangeForeground}" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="Somente leitura · os resultados usam as sessões salvas no calendário."
                       Foreground="{DynamicResource MutedBrush}" FontSize="9.5" VerticalAlignment="Center" />
            <Button x:Name="CloseButton" Style="{StaticResource PrimaryButton}" Click="Close_Click"
                    Width="130" HorizontalAlignment="Right" IsDefault="True" IsCancel="True">Fechar</Button>
        </Grid>
    </Grid>
</Window>
