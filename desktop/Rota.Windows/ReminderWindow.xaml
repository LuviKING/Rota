<Window x:Class="Rota.Desktop.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lembrete de estudos · Rota" Width="620" Height="520" MinWidth="540" MinHeight="430"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Rota;component/Assets/Rota.ico"
        Background="{DynamicResource BackgroundBrush}" Topmost="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="52" Height="52" CornerRadius="15" Background="{DynamicResource PrimarySoftBrush}">
                <TextBlock Text="&#xE823;" Style="{StaticResource IconGlyphText}" FontSize="24"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,1,0,0">
                <TextBlock Text="Hora de estudar" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Este lembrete apenas mostra sua agenda; nada é alterado automaticamente."
                           Foreground="{DynamicResource MutedBrush}" FontSize="10.5" Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,20,0,14" Padding="16,13" CornerRadius="15"
                Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1">
            <Grid>
                <StackPanel>
                    <TextBlock Text="HOJE" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="9.5" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TodaySummary}" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding OverdueSummary}" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" Margin="0,4,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="12"
                        Background="{DynamicResource SurfaceRaisedBrush}" Padding="12,8">
                    <TextBlock Text="{Binding TotalMinutesLabel}" Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="13" FontWeight="Bold" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="16" Padding="16">
            <StackPanel>
                <TextBlock Text="PRÓXIMOS BLOCOS" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding TodayItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Subject}" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Topic}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,12,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding MinutesLabel}" Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding EmptyMessage}" Visibility="{Binding EmptyVisibility}"
                           Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Button Style="{StaticResource SecondaryButton}" Click="Close_Click" Width="112" HorizontalAlignment="Left" IsCancel="True">Fechar</Button>
            <Button x:Name="OpenRotaButton" Style="{StaticResource PrimaryButton}" Click="OpenRota_Click"
                    Width="180" HorizontalAlignment="Right" IsDefault="True">Abrir calendário</Button>
        </Grid>
    </Grid>
</Window>
