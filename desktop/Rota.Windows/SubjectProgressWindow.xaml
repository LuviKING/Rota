<Window x:Class="Rota.Desktop.SubjectProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Progresso por matéria · Rota" Width="900" Height="720" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner" Icon="pack://application:,,,/Rota;component/Assets/Rota.ico"
        Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <Style x:Key="SubjectProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{DynamicResource SubtleBrush}" CornerRadius="4" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{DynamicResource PrimaryBrush}" CornerRadius="4" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="52" Height="52" CornerRadius="15" Background="{DynamicResource PrimarySoftBrush}">
                <TextBlock Text="&#xE9D9;" Style="{StaticResource IconGlyphText}" FontSize="24"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,1,0,0">
                <TextBlock Text="Progresso por matéria" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Todo o calendário salvo · baseado em sessões realmente concluídas"
                           Foreground="{DynamicResource MutedBrush}" FontSize="10.5" Margin="0,5,0,0" />
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,20,0,14">
            <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="MATÉRIAS" Style="{StaticResource SectionLabel}"/><TextBlock Text="{Binding TotalSubjectsLabel}" FontSize="18" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="com sessões no calendário" Foreground="{DynamicResource MutedBrush}" FontSize="9.5" Margin="0,3,0,0"/></StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="MINUTOS CONCLUÍDOS" Style="{StaticResource SectionLabel}"/><TextBlock Text="{Binding CompletedMinutesLabel}" FontSize="18" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="{Binding PlannedMinutesLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="9.5" Margin="0,3,0,0"/></StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="SESSÕES CONCLUÍDAS" Style="{StaticResource SectionLabel}"/><TextBlock Text="{Binding CompletedSessionsLabel}" FontSize="18" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="{Binding PlannedSessionsLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="9.5" Margin="0,3,0,0"/></StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14,12">
                <StackPanel><TextBlock Text="PROGRESSO GERAL" Style="{StaticResource SectionLabel}"/><TextBlock Text="{Binding CompletionLabel}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="pela quantidade de sessões" Foreground="{DynamicResource MutedBrush}" FontSize="9.5" Margin="0,3,0,0"/></StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="13" Padding="14,11" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ProgressBar Style="{StaticResource SubjectProgressBar}" Maximum="100"
                             Value="{Binding CompletionPercent, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <TextBlock Grid.Column="1" Text="{Binding OverallMessage}" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="MATÉRIA POR MATÉRIA" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="{Binding DisplayCountLabel}" HorizontalAlignment="Right"
                               Foreground="{DynamicResource MutedBrush}" FontSize="9.5" />
                </Grid>
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Subjects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/><ColumnDefinition Width="104"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Subject}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StudyDaysLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="9.5" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <ProgressBar Grid.Column="1" Style="{StaticResource SubjectProgressBar}" Maximum="100"
                                                     Value="{Binding CompletionPercent, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,18,0" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MinutesLabel}" FontSize="10.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding RemainingMinutesLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding CompletionLabel}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding SessionsLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,2,0,0" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="Nenhuma matéria foi planejada ainda. Importe ou crie um plano para acompanhar o progresso."
                               Visibility="{Binding EmptyVisibility}" Foreground="{DynamicResource MutedBrush}"
                               FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" />
                </Grid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <TextBlock Text="Este painel mede execução do plano; notas e acertos ainda não são registrados."
                       Foreground="{DynamicResource MutedBrush}" FontSize="9.5" VerticalAlignment="Center" />
            <Button x:Name="CloseButton" Style="{StaticResource PrimaryButton}" Click="Close_Click"
                    Width="130" HorizontalAlignment="Right" IsDefault="True" IsCancel="True">Fechar</Button>
        </Grid>
    </Grid>
</Window>
