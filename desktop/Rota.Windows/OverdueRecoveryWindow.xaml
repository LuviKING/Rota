<Window x:Class="Rota.Desktop.OverdueRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recuperar estudos atrasados · Rota"
        Width="860" Height="700" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Rota;component/Assets/Rota.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="14"
                    Background="{DynamicResource AssessmentSoftBrush}" Margin="0,0,13,0">
                <TextBlock Text="&#xE823;" Style="{StaticResource IconGlyphText}"
                           Foreground="{DynamicResource AssessmentBrush}"
                           FontSize="21" Width="28" Height="28" LineHeight="28" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Recuperar estudos atrasados" FontSize="23" FontWeight="Bold" />
                <TextBlock Text="Revise o que ficou pendente antes de escolher qualquer ação"
                           Foreground="{DynamicResource MutedBrush}" FontSize="10.5" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource AssessmentSoftBrush}"
                BorderBrush="{DynamicResource AssessmentBrush}" BorderThickness="1"
                CornerRadius="14" Padding="16,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="SummaryTitleText" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="SummaryDetailText" Foreground="{DynamicResource MutedBrush}"
                               FontSize="10" TextWrapping="Wrap" Margin="0,4,12,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource SurfaceRaisedBrush}"
                        CornerRadius="10" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock x:Name="OldestBadgeText" Foreground="{DynamicResource AssessmentBrush}"
                               FontSize="9.5" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="15" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="BLOCOS PENDENTES" Style="{StaticResource SectionLabel}" />
                    <TextBlock x:Name="VisibleCountText" HorizontalAlignment="Right"
                               Foreground="{DynamicResource MutedBrush}" FontSize="9.5" />
                </Grid>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
                    <ItemsControl x:Name="OverdueItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="11" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="94" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DateText}" FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DelayText}" Foreground="{DynamicResource AssessmentBrush}"
                                                       FontSize="9.5" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,14,0">
                                            <TextBlock Text="{Binding Subject}" FontSize="12" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Topic}" Foreground="{DynamicResource MutedBrush}"
                                                       FontSize="9.5" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding MinutesText}" FontSize="10.5" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" />
                                            <Border Visibility="{Binding ProtectedVisibility}"
                                                    Background="{DynamicResource ReviewSoftBrush}"
                                                    CornerRadius="8" Padding="7,3" Margin="0,4,0,0">
                                                <TextBlock Text="REVISÃO PROTEGIDA"
                                                           Foreground="{DynamicResource ReviewBrush}"
                                                           FontSize="8.5" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Nenhuma opção desta tela altera o calendário automaticamente."
                       Foreground="{DynamicResource MutedBrush}" FontSize="9.5"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,14,0" />
            <Button x:Name="NotNowButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                    Click="NotNow_Click" MinWidth="106" MinHeight="42" IsCancel="True">Agora não</Button>
            <Button x:Name="ViewOldestButton" Grid.Column="3" Style="{StaticResource SecondaryButton}"
                    Click="ViewOldest_Click" MinWidth="146" MinHeight="42">Ver mais antigo</Button>
            <Button x:Name="PrepareWithAiButton" Grid.Column="5" Style="{StaticResource PrimaryButton}"
                    Click="PrepareWithAi_Click" MinWidth="186" MinHeight="42">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEA80;" Style="{StaticResource IconGlyphText}"
                               Foreground="White" FontSize="15" Width="20" Height="20" LineHeight="20" Margin="0,0,7,0" />
                    <TextBlock Text="Preparar com a IA" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
