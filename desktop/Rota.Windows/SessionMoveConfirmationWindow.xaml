<Window x:Class="Rota.Desktop.SessionMoveConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmar nova data · Rota"
        Width="540" Height="430" MinWidth="460" MinHeight="390"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Rota;component/Assets/Rota.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="14"
                    Background="{DynamicResource PrimarySoftBrush}" Margin="0,0,13,0">
                <TextBlock Text="&#xE8AB;" Style="{StaticResource IconGlyphText}"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="21" Width="28" Height="28" LineHeight="28" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Confirmar mudança de dia" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="Confira a prévia antes de alterar o calendário"
                           Foreground="{DynamicResource MutedBrush}" FontSize="10.5" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="15" Padding="18">
            <StackPanel>
                <TextBlock x:Name="SubjectText" FontSize="16" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TopicText" Foreground="{DynamicResource MutedBrush}"
                           FontSize="11" Margin="0,5,0,16" TextWrapping="Wrap" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="11" Padding="13,11">
                        <StackPanel>
                            <TextBlock Text="DATA ATUAL" Style="{StaticResource SectionLabel}" />
                            <TextBlock x:Name="SourceDateText" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="1" Text="&#xE76C;" Style="{StaticResource IconGlyphText}"
                               Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                    <Border Grid.Column="2" Background="{DynamicResource PrimarySoftBrush}"
                            BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1"
                            CornerRadius="11" Padding="13,11">
                        <StackPanel>
                            <TextBlock Text="NOVA DATA" Style="{StaticResource SectionLabel}" />
                            <TextBlock x:Name="TargetDateText" Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Background="{DynamicResource SuccessSoftBrush}" CornerRadius="10"
                        Padding="12,9" Margin="0,15,0,0">
                    <TextBlock Text="✓ Prazo, rotina e limite diário conferidos. Você poderá desfazer logo depois."
                               Foreground="{DynamicResource SuccessBrush}" FontSize="10.5" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Nada será alterado se você cancelar."
                       Foreground="{DynamicResource MutedBrush}" FontSize="9.5"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                    IsCancel="True" MinWidth="104" MinHeight="42">Cancelar</Button>
            <Button Grid.Column="3" Style="{StaticResource PrimaryButton}"
                    Click="Confirm_Click" IsDefault="True" MinWidth="148" MinHeight="42">Confirmar mudança</Button>
        </Grid>
    </Grid>
</Window>
