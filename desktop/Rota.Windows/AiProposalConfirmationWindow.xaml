<Window x:Class="Rota.Desktop.AiProposalConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revisar proposta · Rota"
        Width="700" Height="660" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="pack://application:,,,/Rota;component/Assets/Rota.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <Style x:Key="ReviewCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="44" Height="44" CornerRadius="13"
                    Background="{DynamicResource PrimarySoftBrush}" Margin="0,0,12,0">
                <TextBlock Text="&#xE72E;" Style="{StaticResource IconGlyphText}"
                           Foreground="{DynamicResource PrimaryTextBrush}" FontSize="21" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Revise antes de aplicar" FontSize="21" FontWeight="Bold" />
                <TextBlock Text="Esta é a avaliação feita agora sobre o calendário atual."
                           Foreground="{DynamicResource MutedBrush}" FontSize="10.5" Margin="0,3,0,0" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,7,0">
                <Border Style="{StaticResource ReviewCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding KindDisplay}" Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="9.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,7,0,0" />
                        <TextBlock Text="{Binding PreviewMessage}" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="10.5" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ReviewCard}" Margin="0,10,0,0"
                        Background="{DynamicResource PrimarySoftBrush}"
                        Visibility="{Binding RecalculatedVisibility}">
                    <TextBlock Text="{Binding ReviewMessage}" Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>

                <UniformGrid Columns="2" Margin="0,10,0,0">
                    <Border Style="{StaticResource ReviewCard}" Margin="0,0,5,0">
                        <StackPanel>
                            <TextBlock Text="SESSÕES FUTURAS" Foreground="{DynamicResource MutedBrush}"
                                       FontSize="9" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SessionMetrics}" Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="17" FontWeight="Bold" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ReviewCard}" Margin="5,0,0,0">
                        <StackPanel>
                            <TextBlock Text="CARGA TOTAL" Foreground="{DynamicResource MutedBrush}"
                                       FontSize="9" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MinuteMetrics}" Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="17" FontWeight="Bold" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource ReviewCard}" Margin="0,10,0,0"
                        Visibility="{Binding OperationsVisibility}">
                    <StackPanel>
                        <TextBlock Text="ALTERAÇÕES DETALHADAS" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="9" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Operations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="8"
                                                Background="{DynamicResource PrimarySoftBrush}" Margin="0,0,9,0">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconGlyphText}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontSize="14" Width="20" Height="20" LineHeight="20" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Summary}" FontSize="10.5" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}"
                                                       FontSize="9.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ReviewCard}" Margin="0,10,0,0"
                        Background="{DynamicResource AssessmentSoftBrush}"
                        Visibility="{Binding WarningsVisibility}">
                    <StackPanel>
                        <TextBlock Text="AVISOS" Foreground="{DynamicResource AssessmentBrush}"
                                   FontSize="9" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,5,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="9.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ReviewCard}" Margin="0,10,0,0"
                        Background="{DynamicResource ErrorSoftBrush}"
                        Visibility="{Binding BlockedVisibility}">
                    <TextBlock Text="{Binding ReviewMessage}" Foreground="{DynamicResource ErrorBrush}"
                               FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="A IA não recebe acesso de escrita. O motor do Rota fará a aplicação."
                       Foreground="{DynamicResource MutedBrush}" FontSize="9.5"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Voltar"
                    MinWidth="96" Click="Cancel_Click" />
            <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="Aplicar no calendário"
                    MinWidth="178" IsEnabled="{Binding CanApply}" Visibility="{Binding ApplyVisibility}"
                    Click="Confirm_Click" AutomationProperties.Name="Confirmar aplicação no calendário" />
        </Grid>
    </Grid>
</Window>
